+                r.boundary = lost;
+            } else {
+                const suffix = a.dupe(u32, ids[n..]) catch return false;
+                a.free(r.suffix);
+                r.suffix = suffix;
+                r.tail = lost;
+            }
+            return true;
+        }
+        return false;
+    }
+};
+
+test "evicted boundaries compare only their actual prefix; tails preserve generated ids" {
+    const a = std.testing.allocator;
+    var h: History = .{};
+    defer h.deinit(a);
+    try h.add(a, &.{ 1, 2, 3 }, &.{}, true);
+    const b: Lost = .{ .id = 7, .n = 2, .variant = 0 };
+    try std.testing.expect(!h.rememberEviction(a, &.{ 9, 2 }, &.{}, true, 0, b));
+    try std.testing.expect(h.rememberEviction(a, &.{ 1, 2 }, &.{}, true, 0, b));
+    var t = b;
+    t.n = 5;
+    try std.testing.expect(h.rememberEviction(a, &.{ 1, 2, 3, 8, 9 }, &.{}, true, 3, t));
+    try std.testing.expectEqualSlices(u32, &.{ 8, 9 }, h.rows[0].suffix);
+}
