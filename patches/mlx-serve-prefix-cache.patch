+const std = @import("std");
+
+test "one hundred prompts rotate and deallocate; media and divergent ids stop matches" {
+    const a = std.testing.allocator;
+    var h: History = .{};
+    defer h.deinit(a);
+    for (0..101) |i| try h.add(a, &.{ @intCast(i), 7 }, &.{.{ .start = 1, .key = 10 }}, true);
+    try std.testing.expectEqual(@as(u64, 101), h.serial);
+    try std.testing.expectEqual(@as(u32, 100), h.rows[0].ids[0]);
+    try std.testing.expectEqual(@as(u32, 1), h.rows[1].ids[0]);
+    try std.testing.expectEqual(@as(usize, 1), common(h.rows[0].ids, &.{ 100, 8 }));
+    try std.testing.expectEqual(@as(usize, 1), mediaSharedBound(h.rows[0].media, &.{.{ .start = 1, .key = 11 }}));
+}
+
+const spans = @import("../../../sdk/kv/media_span.zig");
+pub const mediaSharedBound = spans.mediaSharedBound;
+pub fn common(a: []const u32, b: []const u32) usize {
+    return std.mem.findDiff(u32, a, b) orelse @min(a.len, b.len);
+}
+
+pub const Lost = struct { id: u64, n: usize, variant: u64 };
+const Row = struct {
+    seq: u64 = 0,
+    ids: []const u32 = &.{},
+    media: []const spans.MediaSpan = &.{},
+    tools: bool = false,
+    boundary: ?Lost = null,
+    tail: ?Lost = null,
+    suffix: []const u32 = &.{},
+
+    fn clear(r: *Row, a: std.mem.Allocator) void {
+        a.free(r.ids);
+        a.free(r.media);
+        a.free(r.suffix);
+        r.* = .{};
+    }
+};
+pub const History = struct {
+    rows: [100]Row = @splat(.{}),
+    serial: u64 = 0,
+
+    pub fn deinit(h: *History, a: std.mem.Allocator) void {
+        for (&h.rows) |*r| r.clear(a);
+    }
+    pub fn add(h: *History, a: std.mem.Allocator, ids: []const u32, media: []const spans.MediaSpan, tools: bool) !void {
+        const row = &h.rows[h.serial % h.rows.len];
+        row.clear(a);
+        h.serial += 1;
+        const owned = try a.dupe(u32, ids);
+        errdefer a.free(owned);
+        row.* = .{ .seq = h.serial, .ids = owned, .media = try a.dupe(spans.MediaSpan, media), .tools = tools };
+    }
+    pub fn rememberEviction(h: *History, a: std.mem.Allocator, ids: []const u32, media: []const spans.MediaSpan, tools: bool, tail_from: usize, lost: Lost) bool {
+        const n = if (tail_from > 0) tail_from else ids.len;
+        if (n > ids.len) return false;
+        for (0..@min(h.serial, h.rows.len)) |age| {
+            const r = &h.rows[(h.serial - 1 - age) % h.rows.len];
+            if (r.seq == 0 or r.tools != tools or (if (tail_from > 0) r.ids.len != n else (r.ids.len != n and r.ids.len != n + 1))) continue;
+            if (mediaSharedBound(r.media, media) < n or !std.mem.eql(u32, ids[0..n], r.ids[0..n])) continue;
