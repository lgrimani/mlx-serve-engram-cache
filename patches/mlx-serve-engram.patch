+//! Fixed native Engram rows. Version 1 uses contiguous buckets; version 2 ranks a physical-row bitmap.
+const std = @import("std");
+const builtin = @import("builtin");
+const Sha = std.crypto.hash.sha2.Sha256;
+const page = std.heap.page_size_min;
+const chunk = 8 << 20;
+const max_buckets = 32;
+pub const budget_bytes: u64 = 48 << 30;
+pub const Bucket = struct { row_start: u64, row_count: u64, code_offset: u64, scale_offset: u64 };
+const Layer = struct {
+    layer: u32,
+    source_file: []const u8,
+    source_size: u64,
+    source_header_sha256: []const u8,
+    rows: u64,
+    head_dim: u32,
+    wlen: u32,
+    slen: u32,
+    w_offset: u64,
+    s_offset: u64,
+    w_stride: u64,
+    s_stride: u64,
+    payload_file: []const u8,
+    payload_bytes: u64,
+    payload_sha256: []const u8,
+    buckets: []const Bucket,
+    selected_rows: u64 = 0,
+    bitmap_file: []const u8 = "",
+    bitmap_bytes: u64 = 0,
+    bitmap_sha256: []const u8 = "",
+};
+const Manifest = struct { version: u32, total_payload_bytes: u64, layers: []const Layer };
+pub const Source = struct {
+    fd: c_int,
+    rows: u64,
+    head_dim: u32,
+    wlen: usize,
+    slen: usize,
+    w_offset: u64,
+    s_offset: u64,
+    w_stride: u64,
+    s_stride: u64,
+};
+const Ranked = struct {
+    // Both arrays keep their whole page-rounded allocation so their sizes match the preflight bill.
+    words: []align(page) u64,
+    ranks: []align(page) u32,
+    rows: u32,
+    selected: u32,
+
+    fn deinit(self: Ranked, a: std.mem.Allocator) void {
+        a.free(self.words);
+        a.free(self.ranks);
+    }
+
+    fn index(self: Ranked, id: u32) ?u32 {
+        if (id >= self.rows) return null;
+        const wi = id / 64;
+        const bit = @as(u64, 1) << @intCast(id % 64);
+        const word = self.words[wi];
+        if (word & bit == 0) return null;
+        var rank = self.ranks[wi / 8];
+        for (self.words[wi & ~@as(u32, 7) .. wi]) |prior| rank += @popCount(prior);
+        return rank + @popCount(word & (bit - 1));
+    }
+
+    // Find a contiguous run's boundaries without rereading cold source pages for each singleton.
+    fn nextBit(self: Ranked, from: usize, set: bool) usize {
+        if (from >= self.rows) return self.rows;
+        var i = from / 64;
+        var mask = @as(u64, std.math.maxInt(u64)) << @as(u6, @intCast(from % 64));
+        while (i < std.math.divCeil(usize, self.rows, 64) catch unreachable) : (i += 1) {
+            const word = (if (set) self.words[i] else ~self.words[i]) & mask;
+            if (word != 0) return @min(self.rows, i * 64 + @ctz(word));
+            mask = std.math.maxInt(u64);
+        }
+        return self.rows;
+    }
+};
+
+pub const Store = struct {
+    allocator: std.mem.Allocator,
+    owned: []align(page) u8,
+    buckets: [max_buckets]Bucket = undefined,
+    count: usize,
+    wlen: usize,
+    slen: usize,
+    manifest_sha256: [64]u8,
+    ranked: ?Ranked = null,
+    pub fn deinit(self: *Store) void {
+        if (self.ranked) |r| r.deinit(self.allocator);
+        self.allocator.free(self.owned);
+    }
+    fn find(self: *const Store, id: u32) ?Bucket {
+        if (self.ranked) |r| {
+            const index = r.index(id) orelse return null;
+            return .{ .row_start = id, .row_count = 1, .code_offset = @as(u64, index) * self.wlen, .scale_offset = @as(u64, r.selected) * self.wlen + @as(u64, index) * self.slen };
+        }
+        var lo: usize = 0;
+        var hi = self.count;
+        while (lo < hi) {
+            const mid = lo + (hi - lo) / 2;
+            const b = self.buckets[mid];
+            if (id < b.row_start) hi = mid else if (@as(u64, id) - b.row_start >= b.row_count) lo = mid + 1 else return b;
+        }
+        return null;
+    }
+    pub fn contains(self: *const Store, id: u32) bool {
+        // Membership alone does not need rank/popcount.
+        if (self.ranked) |r| return id < r.rows and r.words[id / 64] & (@as(u64, 1) << @intCast(id % 64)) != 0;
+        return self.find(id) != null;
+    }
+    pub fn copyRow(self: *const Store, id: u32, w: []u8, s: []u8) bool {
+        const b = self.find(id) orelse return false;
+        std.debug.assert(w.len == self.wlen and s.len == self.slen);
+        const row = @as(u64, id) - b.row_start;
+        const wo: usize = @intCast(b.code_offset + row * self.wlen);
+        const so: usize = @intCast(b.scale_offset + row * self.slen);
+        @memcpy(w, self.owned[wo..][0..self.wlen]);
+        @memcpy(s, self.owned[so..][0..self.slen]);
+        return true;
+    }
+};
+fn add(a: u64, b: u64) !u64 {
+    const r = @addWithOverflow(a, b);
+    if (r[1] != 0) return error.EngramCacheManifest;
+    return r[0];
+}
+fn mul(a: u64, b: u64) !u64 {
+    const r = @mulWithOverflow(a, b);
+    if (r[1] != 0) return error.EngramCacheManifest;
+    return r[0];
+}
+fn digest(raw: []const u8) ![32]u8 {
+    if (raw.len != 64) return error.EngramCacheManifest;
+    var d: [32]u8 = undefined;
+    _ = std.fmt.hexToBytes(&d, raw) catch return error.EngramCacheManifest;
+    return d;
+}
+fn hex(d: [32]u8) [64]u8 {
+    const chars = "0123456789abcdef";
+    var out: [64]u8 = undefined;
+    for (d, 0..) |v, i| {
+        out[2 * i] = chars[v >> 4];
+        out[2 * i + 1] = chars[v & 15];
+    }
+    return out;
+}
+fn filename(name: []const u8) bool {
+    return name.len > 0 and name.len < 256 and !std.mem.eql(u8, name, ".") and !std.mem.eql(u8, name, "..") and std.mem.indexOfScalar(u8, name, '/') == null and std.mem.indexOfScalar(u8, name, 92) == null and std.mem.indexOfScalar(u8, name, 0) == null;
+}
+fn validate(m: Manifest) !u64 {
+    if ((m.version != 1 and m.version != 2) or m.layers.len == 0 or m.layers.len > 4) return error.EngramCacheManifest;
+    var total: u64 = 0;
+    var allocated: u64 = chunk + 2 * page + (128 << 10);
+    for (m.layers, 0..) |l, i| {
+        for (m.layers[0..i]) |prior| if (prior.layer == l.layer) return error.EngramCacheManifest;
+        if (!filename(l.source_file) or !filename(l.payload_file) or l.rows == 0 or l.rows > std.math.maxInt(u32) or l.head_dim == 0 or l.head_dim % 32 != 0 or l.wlen != l.head_dim or l.slen != l.head_dim / 32 or l.w_stride != l.wlen or l.s_stride != l.slen or l.buckets.len > max_buckets) return error.EngramCacheManifest;
+        _ = try digest(l.source_header_sha256);
+        _ = try digest(l.payload_sha256);
+        if (try add(l.w_offset, try mul(l.rows, l.w_stride)) > l.source_size or try add(l.s_offset, try mul(l.rows, l.s_stride)) > l.source_size) return error.EngramCacheManifest;
+        if (m.version == 1 and (l.buckets.len == 0 or l.selected_rows != 0 or l.bitmap_bytes != 0 or l.bitmap_file.len != 0 or l.bitmap_sha256.len != 0)) return error.EngramCacheManifest;
+        if (m.version == 2) {
+            if (l.buckets.len != 0 or l.selected_rows == 0 or l.selected_rows > l.rows or !filename(l.bitmap_file) or std.mem.eql(u8, l.bitmap_file, l.payload_file) or l.bitmap_bytes != (l.rows + 63) / 64 * 8) return error.EngramCacheManifest;
+            _ = try digest(l.bitmap_sha256);
+            allocated = try add(allocated, std.mem.alignForward(u64, l.bitmap_bytes, page));
+            allocated = try add(allocated, std.mem.alignForward(u64, (l.rows + 511) / 512 * 4, page));
+        }
+        var end_row: u64 = 0;
+        var end_byte: u64 = try mul(l.selected_rows, @as(u64, l.wlen) + l.slen);
+        for (l.buckets) |b| {
+            const end = try add(b.row_start, b.row_count);
+            if (b.row_count == 0 or b.row_start < end_row or end > l.rows or b.code_offset != end_byte) return error.EngramCacheManifest;
+            const scale = try add(b.code_offset, try mul(b.row_count, l.wlen));
+            if (b.scale_offset != scale) return error.EngramCacheManifest;
+            end_byte = try add(scale, try mul(b.row_count, l.slen));
+            end_row = end;
+        }
+        if (end_byte != l.payload_bytes) return error.EngramCacheManifest;
+        total = try add(total, l.payload_bytes);
+        const rounded = (try add(l.payload_bytes, page - 1)) / page * page;
+        allocated = try add(allocated, try add(rounded, @sizeOf(Store)));
+    }
+    if (total != m.total_payload_bytes) return error.EngramCacheManifest;
+    if (allocated > budget_bytes) return error.EngramCacheBudget;
+    return allocated;
+}
+fn manifest(a: std.mem.Allocator, path: []const u8) !struct { parsed: Manifest, raw: []const u8, allocated: u64 } {
+    const io = std.Io.Threaded.global_single_threaded.io();
+    var dir = try std.Io.Dir.cwd().openDir(io, path, .{});
+    defer dir.close(io);
+    const raw = try dir.readFileAlloc(io, "manifest.json", a, .limited(128 << 10));
+    const m = std.json.parseFromSliceLeaky(Manifest, a, raw, .{ .ignore_unknown_fields = true }) catch return error.EngramCacheManifest;
+    return .{ .parsed = m, .raw = raw, .allocated = try validate(m) };
+}
+pub fn billBytes(path: []const u8) !u64 {
+    if (path.len == 0) return 0;
+    var arena = std.heap.ArenaAllocator.init(std.heap.page_allocator);
+    defer arena.deinit();
+    const m = try manifest(arena.allocator(), path);
+    return m.allocated;
+}
+fn openUncached(path: [:0]const u8) !c_int {
+    const fd = std.c.open(path, .{ .ACCMODE = .RDONLY, .CLOEXEC = true }, @as(std.c.mode_t, 0));
+    if (fd < 0) return error.EngramCacheRead;
+    errdefer _ = std.c.close(fd);
+    if (comptime builtin.os.tag.isDarwin()) {
+        if (std.c.fcntl(fd, std.c.F.NOCACHE, @as(c_int, 1)) != 0) return error.EngramCacheRead;
+    }
+    return fd;
+}
+fn fileSize(fd: c_int) !u64 {
+    var st: std.c.Stat = undefined;
+    if (std.c.fstat(fd, &st) != 0 or st.size < 0) return error.EngramCacheRead;
+    return @intCast(st.size);
+}
+fn readUpTo(fd: c_int, dst: []u8, offset: u64) !usize {
+    var done: usize = 0;
+    while (done < dst.len) {
+        const at = try add(offset, done);
+        if (at > std.math.maxInt(i64)) return error.EngramCacheRead;
+        const n = std.c.pread(fd, dst.ptr + done, dst.len - done, @intCast(at));
+        if (n < 0) return error.EngramCacheRead;
+        if (n == 0) break;
+        done += @intCast(n);
+    }
+    return done;
+}
+fn readExact(fd: c_int, dst: []u8, offset: u64) !void {
+    if (try readUpTo(fd, dst, offset) != dst.len) return error.EngramCacheRead;
+}
+fn headerHash(fd: c_int) ![32]u8 {
+    var first: [8]u8 = undefined;
+    try readExact(fd, &first, 0);
+    const len = std.mem.readInt(u64, &first, .little);
+    if (len < 2 or len > 16 << 20) return error.EngramCacheSource;
+    var h = Sha.init(.{});
+    var buf: [32768]u8 = undefined;
+    var done: u64 = 0;
+    while (done < len) {
+        const n: usize = @intCast(@min(buf.len, len - done));
+        try readExact(fd, buf[0..n], 8 + done);
+        h.update(buf[0..n]);
+        done += n;
+    }
+    return h.finalResult();
+}
+fn sourceOpen(a: std.mem.Allocator, source: Source) !c_int {
+    if (comptime builtin.os.tag.isDarwin()) {
+        var path: [std.c.PATH_MAX]u8 = undefined;
+        if (std.c.fcntl(source.fd, std.c.F.GETPATH, &path) != 0) return error.EngramCacheSource;
+        const p = std.mem.span(@as([*:0]const u8, @ptrCast(&path)));
+        const z = try std.fmt.allocPrintSentinel(a, "{s}", .{p}, 0);
+        const fd = try openUncached(z);
+        errdefer _ = std.c.close(fd);
+        var original: std.c.Stat = undefined;
+        var reopened: std.c.Stat = undefined;
+        if (std.c.fstat(source.fd, &original) != 0 or std.c.fstat(fd, &reopened) != 0 or original.dev != reopened.dev or original.ino != reopened.ino) return error.EngramCacheSource;
+        return fd;
+    } else {
+        const fd = std.c.dup(source.fd);
+        if (fd < 0) return error.EngramCacheSource;
+        return fd;
+    }
+}
+fn compareSource(fd: c_int, offset: u64, expected: []const u8, scratch: []u8) !void {
+    var done: usize = 0;
+    while (done < expected.len) {
+        const at = try add(offset, done);
+        const lo = at / page * page;
+        const skip: usize = @intCast(at - lo);
+        const n = @min(chunk, expected.len - done);
+        const want = std.mem.alignForward(usize, skip + n, page);
+        const got = try readUpTo(fd, scratch[0..want], lo);
+        if (got < skip + n or !std.mem.eql(u8, scratch[skip..][0..n], expected[done..][0..n])) return error.EngramCacheSource;
+        done += n;
+    }
+}
+const SourceWindow = struct {
+    bytes: []u8,
+    start: u64 = 0,
+    valid: usize = 0,
+
+    fn compare(self: *SourceWindow, fd: c_int, offset: u64, expected: []const u8) !void {
+        var done: usize = 0;
+        while (done < expected.len) {
+            const at = offset + done;
+            if (at < self.start or at - self.start >= self.valid) {
+                self.start = at / page * page;
+                self.valid = try readUpTo(fd, self.bytes, self.start);
+                if (at - self.start >= self.valid) return error.EngramCacheSource;
+            }
+            const pos: usize = @intCast(at - self.start);
+            const n = @min(self.valid - pos, expected.len - done);
+            if (!std.mem.eql(u8, self.bytes[pos..][0..n], expected[done..][0..n])) return error.EngramCacheSource;
+            done += n;
+        }
+    }
+};
+
+fn loadRanked(a: std.mem.Allocator, temp: std.mem.Allocator, path: []const u8, l: Layer) !Ranked {
+    const name = try std.fmt.allocPrintSentinel(temp, "{s}/{s}", .{ path, l.bitmap_file }, 0);
+    const fd = try openUncached(name);
+    defer _ = std.c.close(fd);
+    if (try fileSize(fd) != l.bitmap_bytes) return error.EngramCacheRead;
+    const bytes: usize = @intCast(l.bitmap_bytes);
+    const words = try a.alignedAlloc(u64, .fromByteUnits(page), std.mem.alignForward(usize, bytes, page) / 8);
+    errdefer a.free(words);
+    const raw = std.mem.sliceAsBytes(words)[0..bytes];
+    try readExact(fd, raw, 0);
+    var h: [32]u8 = undefined;
+    Sha.hash(raw, &h, .{});
+    const expected = try digest(l.bitmap_sha256);
+    if (!std.mem.eql(u8, &h, &expected)) return error.EngramCacheDigest;
+    const rank_bytes: usize = @intCast((l.rows + 511) / 512 * 4);
+    const ranks = try a.alignedAlloc(u32, .fromByteUnits(page), std.mem.alignForward(usize, rank_bytes, page) / 4);
+    errdefer a.free(ranks);
+    var used: u64 = 0;
+    for (words[0 .. bytes / 8], 0..) |*word, i| {
+        word.* = std.mem.littleToNative(u64, word.*);
+        if (i % 8 == 0) ranks[i / 8] = @intCast(used);
+        used += @popCount(word.*);
+    }
+    const tail: u6 = @intCast(l.rows % 64);
+    if (used != l.selected_rows or (tail != 0 and words[bytes / 8 - 1] >> tail != 0)) return error.EngramCacheManifest;
+    return .{ .words = words, .ranks = ranks, .rows = @intCast(l.rows), .selected = @intCast(used) };
+}
+
+fn compareRanked(src: c_int, l: Layer, r: Ranked, data: []const u8, scratch: []u8) !void {
+    for ([_]u64{ l.w_offset, l.s_offset }, [_]usize{ l.wlen, l.slen }, [_]usize{ 0, @as(usize, r.selected) * l.wlen }) |offset, width, base| {
+        var window = SourceWindow{ .bytes = scratch[0..chunk] };
+        var row: usize = 0;
+        var pos: usize = base;
+        while (row < r.rows) {
+            const start = r.nextBit(row, true);
+            if (start == r.rows) break;
+            row = r.nextBit(start, false);
+            const size = (row - start) * width;
+            try window.compare(src, offset + start * width, data[pos..][0..size]);
+            pos += size;
+        }
+    }
+}
+
+pub fn load(a: std.mem.Allocator, path: []const u8, layer: u32, source: Source) !Store {
+    if (comptime builtin.os.tag == .windows) return error.EngramCacheUnsupported;
+    var arena = std.heap.ArenaAllocator.init(a);
+    defer arena.deinit();
+    const temp = arena.allocator();
+    const parsed = try manifest(temp, path);
+    const l = for (parsed.parsed.layers) |entry| {
+        if (entry.layer == layer) break entry;
+    } else return error.EngramCacheSource;
+    if (l.rows != source.rows or l.head_dim != source.head_dim or l.wlen != source.wlen or l.slen != source.slen or l.w_offset != source.w_offset or l.s_offset != source.s_offset or l.w_stride != source.w_stride or l.s_stride != source.s_stride) return error.EngramCacheSource;
+    const src = try sourceOpen(temp, source);
+    defer _ = std.c.close(src);
+    if (try fileSize(src) != l.source_size) return error.EngramCacheSource;
+    const actual_header = try headerHash(src);
+    const expected_header = try digest(l.source_header_sha256);
+    if (!std.mem.eql(u8, &actual_header, &expected_header)) return error.EngramCacheSource;
+    const data_path = try std.fmt.allocPrintSentinel(temp, "{s}/{s}", .{ path, l.payload_file }, 0);
+    const fd = try openUncached(data_path);
+    defer _ = std.c.close(fd);
+    if (try fileSize(fd) != l.payload_bytes) return error.EngramCacheRead;
+    const n = std.math.cast(usize, l.payload_bytes) orelse return error.EngramCacheBudget;
+    const allocation = std.mem.alignForward(usize, n, page);
+    const data = try a.alignedAlloc(u8, .fromByteUnits(page), allocation);
+    errdefer a.free(data);
+    var h = Sha.init(.{});
+    var done: usize = 0;
+    while (done < n) {
+        const end = done + @min(chunk, n - done);
+        try readExact(fd, data[done..end], done);
+        h.update(data[done..end]);
+        done = end;
+    }
+    const actual_payload = h.finalResult();
+    const expected_payload = try digest(l.payload_sha256);
+    if (!std.mem.eql(u8, &actual_payload, &expected_payload)) return error.EngramCacheDigest;
