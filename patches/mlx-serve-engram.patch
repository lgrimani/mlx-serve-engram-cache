+test "engram resident: v2 physical row bitmap ranks native payload, validates identity and rejects malformed indexes" {
+    if (comptime builtin.os.tag == .windows) return error.SkipZigTest;
+    const a = std.testing.allocator;
+    const io = std.Io.Threaded.global_single_threaded.io();
+    var td = std.testing.tmpDir(.{});
+    defer td.cleanup();
+    var pbuf: [4096]u8 = undefined;
+    const path = pbuf[0..try td.dir.realPath(io, &pbuf)];
+    const rows = 1089;
+    const ids = [_]u32{ 0, 63, 64, 511, 512, 1023, 1024, 1088 };
+    const scales = 10 + rows * 32;
+    var source: [scales + rows]u8 = undefined;
+    std.mem.writeInt(u64, source[0..8], 2, .little);
+    @memcpy(source[8..10], "{}");
+    for (source[10..], 0..) |*b, i| b.* = @truncate(i * 13 + i / 512);
+    try td.dir.writeFile(io, .{ .sub_path = "source.safetensors", .data = &source });
+    const name = try std.fmt.allocPrintSentinel(a, "{s}/source.safetensors", .{path}, 0);
+    defer a.free(name);
+    const fd = try openUncached(name);
+    defer _ = std.c.close(fd);
+    const src = Source{ .fd = fd, .rows = rows, .head_dim = 32, .wlen = 32, .slen = 1, .w_offset = 10, .s_offset = scales, .w_stride = 32, .s_stride = 1 };
+    var data: [ids.len * 33]u8 = undefined;
+    var bits: [((rows + 63) / 64) * 8]u8 = @splat(0);
+    for (ids, 0..) |id, i| {
+        bits[id / 8] |= @as(u8, 1) << @intCast(id % 8);
+        @memcpy(data[i * 32 ..][0..32], source[10 + id * 32 ..][0..32]);
+        data[ids.len * 32 + i] = source[scales + id];
+    }
+    var h: [32]u8 = undefined;
+    Sha.hash("{}", &h, .{});
+    const hhead = hex(h);
+    Sha.hash(&data, &h, .{});
+    const hdata = hex(h);
+    Sha.hash(&bits, &h, .{});
+    var hbits = hex(h);
+    const layers = .{.{
+        .layer = @as(u32, 1),
+        .source_file = "source.safetensors",
+        .source_size = source.len,
+        .source_header_sha256 = hhead[0..],
+        .rows = rows,
+        .head_dim = 32,
+        .wlen = 32,
+        .slen = 1,
+        .w_offset = 10,
+        .s_offset = scales,
+        .w_stride = 32,
+        .s_stride = 1,
+        .payload_file = "L1.bin",
+        .payload_bytes = data.len,
+        .payload_sha256 = hdata[0..],
+        .buckets = @as([]const Bucket, &.{}),
+        .selected_rows = ids.len,
+        .bitmap_file = "L1.bits",
+        .bitmap_bytes = bits.len,
+        .bitmap_sha256 = hbits[0..],
+    }};
+    const save = struct {
+        fn run(alloc: std.mem.Allocator, dir: std.Io.Dir, vals: anytype) !void {
+            const raw = try std.json.Stringify.valueAlloc(alloc, .{ .version = @as(u32, 2), .total_payload_bytes = vals[0].payload_bytes, .layers = vals }, .{});
+            defer alloc.free(raw);
+            try dir.writeFile(std.Io.Threaded.global_single_threaded.io(), .{ .sub_path = "manifest.json", .data = raw });
+        }
+    }.run;
+    try td.dir.writeFile(io, .{ .sub_path = "L1.bin", .data = &data });
+    try td.dir.writeFile(io, .{ .sub_path = "L1.bits", .data = &bits });
+    try save(a, td.dir, &layers);
+    var cache = try load(a, path, 1, src);
+    defer cache.deinit();
+    var w: [32]u8 = undefined;
+    var s: [1]u8 = undefined;
+    for (0..rows + 1) |i| {
+        const id: u32 = @intCast(i);
+        const member = std.mem.indexOfScalar(u32, &ids, id) != null;
+        try std.testing.expectEqual(member, cache.contains(id));
+        try std.testing.expectEqual(member, cache.copyRow(id, &w, &s));
+        if (member) {
+            try std.testing.expectEqualSlices(u8, source[10 + i * 32 ..][0..32], &w);
+            try std.testing.expectEqual(source[scales + i], s[0]);
+        }
+    }
+    try std.testing.expect(!cache.contains(std.math.maxInt(u32)));
+    bits[0] ^= 2;
+    try td.dir.writeFile(io, .{ .sub_path = "L1.bits", .data = &bits });
+    try std.testing.expectError(error.EngramCacheDigest, load(a, path, 1, src));
+    Sha.hash(&bits, &h, .{});
+    hbits = hex(h);
+    try save(a, td.dir, &layers);
+    try std.testing.expectError(error.EngramCacheManifest, load(a, path, 1, src));
+    bits[0] ^= 3;
+    bits[bits.len - 1] = 0x80;
+    Sha.hash(&bits, &h, .{});
+    hbits = hex(h);
+    try td.dir.writeFile(io, .{ .sub_path = "L1.bits", .data = &bits });
+    try save(a, td.dir, &layers);
+    try std.testing.expectError(error.EngramCacheManifest, load(a, path, 1, src));
+    bits[bits.len - 1] = 0;
+    bits[0] ^= 2;
+    Sha.hash(&bits, &h, .{});
+    hbits = hex(h);
+    try td.dir.writeFile(io, .{ .sub_path = "L1.bits", .data = &bits });
+    try save(a, td.dir, &layers);
+    try std.testing.expectError(error.EngramCacheSource, load(a, path, 1, src));
+}
diff --git a/src/plugins/deepseek_v41/engram_settings.zig b/src/plugins/deepseek_v41/engram_settings.zig
new file mode 100644
index 0000000..1e9854f
--- /dev/null
+++ b/src/plugins/deepseek_v41/engram_settings.zig
@@ -0,0 +1,63 @@
+//! Load-time controls and the complete Engram host-store budget.
+const std = @import("std");
+const env = @import("../../env.zig");
+const decode = @import("decode/engram_decode.zig");
+const resident = @import("engram_resident.zig");
+pub const combined_budget_bytes: u64 = 56 << 30;
+
+pub fn parsePath(value: ?[]const u8) !?[]const u8 {
+    const v = value orelse return null;
+    if (v.len == 0) return null;
+    if (!std.fs.path.isAbsolute(v)) return error.EngramCachePath;
+    return v;
+}
+
+pub fn path() !?[]const u8 {
+    return parsePath(env.span(.MLX_SERVE_DSV41_ENGRAM_CACHE));
+}
+
+pub fn combinedBytes(hot: u64, lru: u64) !u64 {
+    if (hot > resident.budget_bytes or lru > combined_budget_bytes - hot) return error.EngramCacheBudget;
+    return hot + lru;
+}
+
+pub fn hotBytes(has_tables: bool) !u64 {
+    if (!has_tables) return 0;
+    const p = (try path()) orelse return 0;
+    return resident.billBytes(p);
+}
+
+pub fn storeBytes(has_tables: bool) !u64 {
+    const hot = try hotBytes(has_tables);
+    if (!has_tables) return 0;
+    const lru = @as(u64, try decode.parseMb(env.span(.MLX_SERVE_DSV41_ENGRAM_LRU_MB))) << 20;
+    return combinedBytes(hot, lru);
+}
+
+/// The fixed pack opts in to CPU-store-aware preflight; preserve normal admission otherwise.
+pub fn configuredStoreBytes(has_tables: bool) !u64 {
+    if (!has_tables or (try path()) == null) return 0;
+    return storeBytes(true);
+}
+
+pub fn configure(has_tables: bool) !void {
+    _ = try storeBytes(has_tables);
+    decode.ps().lru_mb = try decode.parseMb(env.span(.MLX_SERVE_DSV41_ENGRAM_LRU_MB));
+}
+
+test "dsv41 Engram settings: only an absolute cache directory is accepted" {
+    try std.testing.expectEqual(@as(?[]const u8, null), try parsePath(null));
+    try std.testing.expectEqual(@as(?[]const u8, null), try parsePath(""));
+    try std.testing.expectEqualStrings("/cache/engram", (try parsePath("/cache/engram")).?);
+    try std.testing.expectError(error.EngramCachePath, parsePath("cache/engram"));
+}
+
+test "dsv41 Engram settings: the fixed cache and LRU share one 56 GiB cap" {
+    const lru: u64 = 256 << 20;
+    try std.testing.expectEqual(lru, try combinedBytes(0, lru));
+    try std.testing.expectEqual(@as(u64, 56 << 30), try combinedBytes(48 << 30, 8 << 30));
+    try std.testing.expectEqual(@as(u64, 40 << 30), try combinedBytes(32 << 30, 8 << 30));
+    try std.testing.expectError(error.EngramCacheBudget, combinedBytes(48 << 30, (8 << 30) + 1));
+    try std.testing.expectError(error.EngramCacheBudget, combinedBytes(resident.budget_bytes + 1, lru));
+    try std.testing.expectError(error.EngramCacheBudget, combinedBytes(std.math.maxInt(u64), lru));
+}
