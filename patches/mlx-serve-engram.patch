+/// Sum each indexed file once for a tensor worker before it loads any weights.
+fn cacheShardBytes(io: std.Io, model_dir: []const u8) !u64 {
+    const resident_weights = @import("../../../sdk/weights/resident.zig");
+    var dir = try std.Io.Dir.openDirAbsolute(io, model_dir, .{});
+    defer dir.close(io);
+    var referenced = resident_weights.indexShardSet(io, dir) orelse return error.EngramCacheUnbilled;
+    defer resident_weights.freeShardSet(&referenced);
+    var total: u64 = 0;
+    var it = referenced.keyIterator();
+    while (it.next()) |name| {
+        if (std.fs.path.isAbsolute(name.*) or std.mem.indexOf(u8, name.*, "..") != null) return error.EngramCacheUnbilled;
+        const st = dir.statFile(io, name.*, .{}) catch return error.EngramCacheUnbilled;
+        if (st.kind != .file) return error.EngramCacheUnbilled;
+        total = std.math.add(u64, total, @intCast(st.size)) catch return error.EngramCacheUnbilled;
+    }
+    if (total == 0) return error.EngramCacheUnbilled;
+    return total;
