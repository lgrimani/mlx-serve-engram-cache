+        const wn: usize = @intCast(b.row_count * l.wlen);
+        const sn: usize = @intCast(b.row_count * l.slen);
+        const wo: usize = @intCast(b.code_offset);
+        const so: usize = @intCast(b.scale_offset);
+        try compareSource(src, l.w_offset + b.row_start * l.w_stride, data[wo..][0..wn], scratch);
+        try compareSource(src, l.s_offset + b.row_start * l.s_stride, data[so..][0..sn], scratch);
+    }
+    var msha: [32]u8 = undefined;
+    Sha.hash(parsed.raw, &msha, .{});
+    var result = Store{ .allocator = a, .owned = data, .count = l.buckets.len, .wlen = l.wlen, .slen = l.slen, .manifest_sha256 = hex(msha), .ranked = ranked };
+    @memcpy(result.buckets[0..l.buckets.len], l.buckets);
+    return result;
+}
+test "engram resident: mixed rows preserve packed bytes" {
+    const a = std.testing.allocator;
+    const data = try a.alignedAlloc(u8, .fromByteUnits(page), page);
+    defer a.free(data);
+    @memcpy(data[0..15], &[_]u8{ 10, 11, 12, 13, 20, 21, 22, 23, 110, 120, 50, 51, 52, 53, 150 });
+    var cache = Store{ .allocator = a, .owned = data, .count = 2, .wlen = 4, .slen = 1, .manifest_sha256 = @splat('0') };
+    cache.buckets[0] = .{ .row_start = 1, .row_count = 2, .code_offset = 0, .scale_offset = 8 };
+    cache.buckets[1] = .{ .row_start = 5, .row_count = 1, .code_offset = 10, .scale_offset = 14 };
+    var w: [4]u8 = @splat(0xaa);
+    var s: [1]u8 = @splat(0xbb);
+    try std.testing.expect(cache.copyRow(2, &w, &s));
+    try std.testing.expectEqualSlices(u8, &.{ 20, 21, 22, 23 }, &w);
+    try std.testing.expectEqualSlices(u8, &.{120}, &s);
+    try std.testing.expect(!cache.copyRow(3, &w, &s));
+    try std.testing.expectEqualSlices(u8, &.{ 20, 21, 22, 23 }, &w);
+    try std.testing.expect(!cache.contains(0));
+    try std.testing.expect(!cache.contains(6));
+}
