diff --git a/src/sdk/util/load_capacity.zig b/src/sdk/util/load_capacity.zig
new file mode 100644
index 0000000..d63ec93
--- /dev/null
+++ b/src/sdk/util/load_capacity.zig
@@ -0,0 +1,16 @@
+//! Physical RAM and Metal capacity for loads with a CPU-only store.
+const std = @import("std");
+
+pub fn combinedAvailable(ram_room: u64, gpu_available: u64, host_store: u64) u64 {
+    return @min(ram_room, gpu_available +| host_store);
+}
+
+pub fn requirement(need: u64) u64 {
+    return need +| (@min(need / 8, 6 << 30) + (1 << 30));
+}
+
+test "load capacity: host bytes consume RAM and the requirement saturates" {
+    try std.testing.expectEqual(@as(u64, 248), combinedAvailable(248, 200, 48));
+    try std.testing.expectEqual(@as(u64, 224), combinedAvailable(224, 200, 48));
+    try std.testing.expectEqual(std.math.maxInt(u64), requirement(std.math.maxInt(u64)));
+}
