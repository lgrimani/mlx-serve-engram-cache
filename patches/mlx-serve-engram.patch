+    errdefer if (ranked) |r| r.deinit(a);
+    const scratch = try a.alignedAlloc(u8, .fromByteUnits(page), chunk + 2 * page);
+    defer a.free(scratch);
+    if (ranked) |r| try compareRanked(src, l, r, data[0..n], scratch);
